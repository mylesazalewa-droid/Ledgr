rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Private user data ────────────────────────────────────────────────────
    // Only the authenticated owner can read or write their own documents.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Public storefronts ───────────────────────────────────────────────────
    // Anyone can read a storefront profile and its items (no login required).
    // Only the authenticated owner can write their storefront data.
    match /storefronts/{userId} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /items/{itemId} {
        allow read:  if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Buyer messages ───────────────────────────────────────────────────────
    // Anyone can send a message to a seller (buyers don't need an account).
    // Only the authenticated seller can read, update, or delete their messages.
    match /messages/{sellerId}/inbox/{messageId} {
      allow create:               if true;
      allow read, update, delete: if request.auth != null && request.auth.uid == sellerId;
    }
  }
}
